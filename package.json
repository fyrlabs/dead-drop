{
  "name": "dead-drop",
  "version": "0.11.0",
  "private": true,
  "description": "dead-drop: a transport-agnostic runtime for distributed applications",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fyrlabs/dead-drop.git"
  },
  "homepage": "https://github.com/fyrlabs/dead-drop#readme",
  "bugs": "https://github.com/fyrlabs/dead-drop/issues",
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "packages/transport-sdk",
    "packages/dead-drop",
    "examples/*"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean && rm -rf coverage",
    "typecheck": "tsc --build --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run lint && npm run build && npm run test:coverage"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
