{"nodes": [{"id": "docs_adr_0002_filesystem_as_reference_transport_adr", "label": "ADR 0002: filesystem is the reference transport, not GitHub", "file_type": "document", "source_file": "docs/adr/0002-filesystem-as-reference-transport.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Status accepted. Reverses the original sketch's plan to build GitHub first, because 'build one complete transport to validate the abstraction' only works if the validation is repeatable."}, {"id": "docs_adr_0002_filesystem_as_reference_transport_filesystem_reference", "label": "Filesystem as the reference transport", "file_type": "concept", "source_file": "docs/adr/0002-filesystem-as-reference-transport.md", "source_location": "line 21", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two runtimes pointed at one directory exercise the entire stack (encryption, chunking, acknowledgement, discovery, proxying) with no credentials and no network, so the full stack is verified on every commit by anyone in seconds. It is also independently useful: a shared mount, SMB share, Dropbox or OneDrive folder, or two runtimes on one machine."}, {"id": "docs_adr_0002_filesystem_as_reference_transport_github_untestable", "label": "GitHub cannot be tested in CI", "file_type": "rationale", "source_file": "docs/adr/0002-filesystem-as-reference-transport.md", "source_location": "lines 11-18", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exercising GitHub needs a token, a repository, network access and an account, so CI cannot run it and a contributor cannot run it. The abstraction it was meant to validate would be validated by a suite nobody can execute."}, {"id": "docs_adr_0002_filesystem_as_reference_transport_end_to_end_suite", "label": "End-to-end suite over two runtimes and one directory", "file_type": "concept", "source_file": "docs/adr/0002-filesystem-as-reference-transport.md", "source_location": "line 21", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs against the filesystem transport so the whole stack is covered without credentials or network."}, {"id": "docs_adr_0002_filesystem_as_reference_transport_git_transport", "label": "git transport (second transport)", "file_type": "concept", "source_file": "docs/adr/0002-filesystem-as-reference-transport.md", "source_location": "line 23", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tested against a local bare repository, which is a real git remote, so clone, commit, push, fetch, reset and the push-race path are genuinely exercised with no network and no credentials."}, {"id": "docs_adr_0002_filesystem_as_reference_transport_local_bare_repository", "label": "Local bare repository test fixture", "file_type": "concept", "source_file": "docs/adr/0002-filesystem-as-reference-transport.md", "source_location": "lines 23, 25", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A real git remote without network or credentials, which is what makes the git and github transports testable at all."}, {"id": "docs_adr_0002_filesystem_as_reference_transport_push_race_path", "label": "Push-race path", "file_type": "concept", "source_file": "docs/adr/0002-filesystem-as-reference-transport.md", "source_location": "line 23", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Concurrent pushes to the shared data branch, exercised against the local bare repo rather than left to live-service luck."}, {"id": "docs_adr_0002_filesystem_as_reference_transport_github_transport", "label": "GitHub transport as a thin layer over git", "file_type": "concept", "source_file": "docs/adr/0002-filesystem-as-reference-transport.md", "source_location": "line 25", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adds only what is GitHub-specific: gh-based authentication, repository resolution and creation, and rate-limit reporting. Keeping it thin is what lets a scripted fake gh plus a local bare repo cover its logic."}, {"id": "docs_adr_0002_filesystem_as_reference_transport_scripted_fake_gh", "label": "Scripted fake gh CLI", "file_type": "concept", "source_file": "docs/adr/0002-filesystem-as-reference-transport.md", "source_location": "line 25", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Substitutes for the live gh binary so GitHub-specific logic is testable offline."}, {"id": "docs_adr_0002_filesystem_as_reference_transport_manual_checklist", "label": "Manual live-GitHub checklist in docs/testing.md", "file_type": "document", "source_file": "docs/adr/0002-filesystem-as-reference-transport.md", "source_location": "lines 25, 31", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Real rate limits, real auth failures and real large-repo latency are only covered by a human running the checklist. Recorded explicitly rather than hidden behind a green tick."}], "edges": [{"source": "docs_adr_0002_filesystem_as_reference_transport_github_untestable", "target": "docs_adr_0002_filesystem_as_reference_transport_adr", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0002-filesystem-as-reference-transport.md", "source_location": "lines 11-18", "weight": 1.0}, {"source": "docs_adr_0002_filesystem_as_reference_transport_adr", "target": "docs_adr_0002_filesystem_as_reference_transport_filesystem_reference", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0002-filesystem-as-reference-transport.md", "source_location": "line 21", "weight": 1.0}, {"source": "docs_adr_0002_filesystem_as_reference_transport_end_to_end_suite", "target": "docs_adr_0002_filesystem_as_reference_transport_filesystem_reference", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0002-filesystem-as-reference-transport.md", "source_location": "line 21", "weight": 1.0}, {"source": "docs_adr_0002_filesystem_as_reference_transport_git_transport", "target": "docs_adr_0002_filesystem_as_reference_transport_local_bare_repository", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0002-filesystem-as-reference-transport.md", "source_location": "line 23", "weight": 1.0}, {"source": "docs_adr_0002_filesystem_as_reference_transport_local_bare_repository", "target": "docs_adr_0002_filesystem_as_reference_transport_push_race_path", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0002-filesystem-as-reference-transport.md", "source_location": "line 23", "weight": 1.0}, {"source": "docs_adr_0002_filesystem_as_reference_transport_github_transport", "target": "docs_adr_0002_filesystem_as_reference_transport_git_transport", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0002-filesystem-as-reference-transport.md", "source_location": "line 25", "weight": 1.0}, {"source": "docs_adr_0002_filesystem_as_reference_transport_github_transport", "target": "docs_adr_0002_filesystem_as_reference_transport_scripted_fake_gh", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0002-filesystem-as-reference-transport.md", "source_location": "line 25", "weight": 1.0}, {"source": "docs_adr_0002_filesystem_as_reference_transport_github_transport", "target": "docs_adr_0002_filesystem_as_reference_transport_manual_checklist", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0002-filesystem-as-reference-transport.md", "source_location": "lines 25, 31", "weight": 1.0},