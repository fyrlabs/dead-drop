ding_handler_pool", "target": "changelog_concurrency_setting", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "CHANGELOG.md", "source_location": "Unreleased", "weight": 1}, {"source": "changelog_working_tree_serialization", "target": "changelog_git_transport", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "CHANGELOG.md", "source_location": "Unreleased", "weight": 1}, {"source": "changelog_working_tree_serialization", "target": "changelog_git_push_verification", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.8, "source_file": "CHANGELOG.md", "source_location": null, "weight": 0.8}, {"source": "changelog_git_push_verification", "target": "changelog_git_transport", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "CHANGELOG.md", "source_location": "0.2.4", "weight": 1}, {"source": "changelog_git_push_verification", "target": "changelog_github_transport", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "CHANGELOG.md", "source_location": "0.2.4", "weight": 1}, {"source": "changelog_per_runtime_clone", "target": "changelog_git_transport", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "CHANGELOG.md", "source_location": "0.2.5", "weight": 1}, {"source": "changelog_per_runtime_clone", "target": "changelog_ddrop_connect", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "CHANGELOG.md", "source_location": "0.2.5", "weight": 1}, {"source": "changelog_branch_compaction", "target": "changelog_git_transport", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "CHANGELOG.md", "source_location": "0.8.0", "weight": 1}, {"source": "changelog_branch_compaction", "target": "changelog_github_transport", "relation": "references", "confidence": "EXTRACTED