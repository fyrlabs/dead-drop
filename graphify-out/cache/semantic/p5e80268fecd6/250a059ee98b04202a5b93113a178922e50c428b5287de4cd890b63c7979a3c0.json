{"nodes": [{"id": "changelog", "label": "dead-drop Changelog", "file_type": "document", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "changelog_dead_drop_package", "label": "@fyrlabs/dead-drop package", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.2.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Everything except the transport contract ships in one package reachable by subpath (/sdk, /runtime, /core, /protocol, /cli, /transports/<name>), replacing ten packages."}, {"id": "changelog_transport_sdk", "label": "@fyrlabs/dead-drop-transport-sdk", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.2.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Versions independently from dead-drop (1.0.0) because the contract is settled; kept separate so a third-party adapter does not depend on the whole runtime and keeps working across dead-drop majors."}, {"id": "changelog_deaddroperror", "label": "DeadDropError", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.2.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Moved into transport-sdk because adapters must throw it and the transport manager reads its retryable flag. DeadDropError.is brand-checks a Symbol.for key instead of instanceof so errors from two copies of transport-sdk are still recognised; otherwise UNAUTHORIZED was rewrapped as retryable INTERNAL and retried forever."}, {"id": "changelog_concurrency_setting", "label": "concurrency workspace setting", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.5.0, Unreleased", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Raising it removes head-of-line blocking behind a slow handler, at the cost of out-of-order answers. Default 1 keeps prior behaviour."}, {"id": "changelog_sliding_handler_pool", "label": "Sliding handler pool", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "Unreleased", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Concurrency previously only applied to messages found in the same poll, so a long handler blocked later arrivals; a new message now starts as soon as a slot is free."}, {"id": "changelog_working_tree_serialization", "label": "Serialized git working-tree operations", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "Unreleased", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reads could reset the working tree between a concurrent write's commit and push, causing a recovered-but-logged replay; serialising pushes the commit once without the warning."}, {"id": "changelog_git_transport", "label": "git transport", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "changelog_github_transport", "label": "github transport", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses the gh CLI with rate-limit awareness; initially validated only against a scripted gh and a local bare repo."}, {"id": "changelog_filesystem_transport", "label": "filesystem transport", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.1.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "changelog_memory_transport", "label": "memory transport", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.1.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "changelog_git_push_verification", "label": "Push verified on remote-tracking branch", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.2.4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "git push exits 0 with Everything up-to-date when the intended commit is no longer HEAD, silently dropping messages when processes share a clone; a live GitHub run lost 10 of 50 requests."}, {"id": "changelog_per_runtime_clone", "label": "Per-runtime clone under <workDir>.peers", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.2.5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Git does not support two runtimes sharing one working tree; the second runtime clones into its own directory."}, {"id": "changelog_branch_compaction", "label": "Data branch compaction (compactAfterCommits)", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.8.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every message left a permanent commit, slowing joins and approaching host size limits; past 500 commits the branch is squashed. Must be off on force-push-protected branches."}, {"id": "changelog_inbox_orphan_cleanup", "label": "Orphaned inbox cleanup (inboxOrphanMs)", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.10.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only the addressee empties its inbox, so mail for departed peers was never reclaimed (60 MB in one trial repo). Deletion requires both age over 7 days and a stopped presence beacon so briefly offline peers keep their mail."}, {"id": "changelog_presence_beacons", "label": "Presence beacons", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only one published at a time and abandoned when too old, so a slow backend is not pushed into failure by its own presence records."}, {"id": "changelog_streaming_responses", "label": "Streaming response bodies", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.16.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lets server-sent events and unbounded bodies work and avoids buffering large files in memory on both peers; a caller that stops reading stops the sender."}, {"id": "changelog_ddrop_expose", "label": "ddrop expose", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "changelog_ddrop_connect", "label": "ddrop connect", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Binds its local port without waiting for a presence beacon so it works during a transport outage."}, {"id": "changelog_content_encoding_fix", "label": "Proxy disables target compression", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.15.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Decompressed bytes were forwarded still labelled gzip, causing ERR_CONTENT_DECODING_FAILED; frames are already compressed a layer down so nothing grows on the wire."}, {"id": "changelog_reply_wait_polling", "label": "Fast polling while awaiting a reply", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.15.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A waiting peer used to back off to 15s as if idle; measured 18s per request before, 5s after. Idle peers still back off so quiet workspaces cost the same."}, {"id": "changelog_ddrop_rotate", "label": "ddrop rotate (key rotation)", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.13.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Removing a peer no longer requires distributing a new shared secret; the new key is wrapped for each peer that may still read."}, {"id": "changelog_peer_enrollment", "label": "Peer enrollment (requireApproval)", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.13.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "For users who do not trust the shared storage; approval records the fingerprint so a changed key loses approval instead of inheriting it."}, {"id": "changelog_ddrop_peer_commands", "label": "ddrop peer list/approve/revoke", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.13.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Answers who may read, as opposed to ddrop discover which answers who is running."}, {"id": "changelog_ddrop_discover", "label": "ddrop discover", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.6.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Now exits 1 naming the failed transport so an unreachable workspace does not look empty."}, {"id": "changelog_ddrop_init", "label": "ddrop init", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Writes a working config: generated secret file, explicit peer id to avoid hostname collisions, REPLACE-ME for the shared location; --github and --secret make setup and joining one command."}, {"id": "changelog_ddrop_dashboard", "label": "ddrop dashboard", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.7.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Read-only, starts no runtime; meant to run while being viewed since local processes can read workspace metadata from the port."}, {"id": "changelog_ddrop_queues", "label": "ddrop queues / client.queues()", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.6.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shows lagging peers without waiting for timeouts; reads object keys only, decrypting and consuming nothing."}, {"id": "changelog_control_socket", "label": "Control socket", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.2.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unix socket paths cap at 104 bytes, so deep data dirs fall back to a hashed short path under temp, matching Windows named pipes."}, {"id": "changelog_policy_parallel_mode", "label": "policy mode parallel", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.11.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "For peers that cannot all reach the same transports; costs a write on every transport per message."}, {"id": "changelog_transport_manager", "label": "Transport manager (scoring, retry, circuit breaker, failover)", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Retry no longer backs off in front of an open breaker so failover takes seconds; non-retryable health failures are logged at error level."}, {"id": "changelog_retry_breaker_config", "label": "retry and breaker workspace config", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.4.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Raising retry.maxAttempts alone buys nothing because requestTimeoutMs bounds the whole request."}, {"id": "changelog_request_timeout", "label": "requestTimeoutMs (whole-request deadline)", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.3.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Previously guarded only the reply wait, so a failing send could run unbounded (15s requested, two minutes waited)."}, {"id": "changelog_allowpeers", "label": "allowPeers", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.3.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Matches configured peerId rather than reply address, since ddrop connect uses a per-process address found in no config."}, {"id": "changelog_peer_identity_address_split", "label": "Peer identity vs mailbox address split", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.3.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lets a short-lived session take its own address without losing its identity."}, {"id": "changelog_config_file_placeholder", "label": "${file:PATH} config placeholder", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.4.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lets a config be committed with the secret beside it rather than inside it."}, {"id": "changelog_object_key_layout", "label": "Cleartext object keys ws/<workspace>/inbox/<peer>/<id>.ddf", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.2.3, 0.4.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deliberately readable so an operator can understand a repository; earlier docs wrongly claimed names never appear in clear text."}, {"id": "changelog_envelope_encryption", "label": "AES-256-GCM envelope encryption", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.1.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "changelog_at_least_once_delivery", "label": "At-least-once delivery over object storage", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.1.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Duplicates are suppressed not prevented, so handlers must be idempotent."}, {"id": "changelog_conformance_suite", "label": "Transport conformance suite", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.6.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Checks nested prefix listing; an adapter that listed only direct children would report every queue empty."}, {"id": "changelog_eslint_layering_rule", "label": "eslint no-restricted-imports layering rule", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.2.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces package boundaries after consolidation: protocol imports nothing above it, core never names a transport, transports see only protocol and transport SDK."}, {"id": "changelog_e2e_script", "label": "scripts/e2e.sh", "file_type": "code", "source_file": "CHANGELOG.md", "source_location": "0.2.6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One scenario suite with fast (CI) and live (GitHub) tiers, replacing two older check scripts."}, {"id": "changelog_two_peer_check", "label": "scripts/two-peer-check.sh", "file_type": "code", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "c