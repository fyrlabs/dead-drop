{"nodes": [{"id": "docs_configuration", "label": "Configuration reference", "file_type": "document", "source_file": "docs/configuration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_configuration_parse_runtime_config", "label": "parseRuntimeConfig", "file_type": "code", "source_file": "docs/configuration.md", "source_location": "intro", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_configuration_references", "label": "${env:NAME} and ${file:PATH} references", "file_type": "concept", "source_file": "docs/configuration.md", "source_location": "Rules that apply to every field", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unset variables or unreadable files are hard errors and expansion is single-pass, so a missing secret fails loudly and expanded values are never re-followed."}, {"id": "docs_configuration_placeholders", "label": "REPLACE-ME placeholder", "file_type": "concept", "source_file": "docs/configuration.md", "source_location": "Rules that apply to every field", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The shared location cannot be defaulted; a local default let two machines start cleanly and never see each other."}, {"id": "docs_configuration_peer_id", "label": "peerId and DEADDROP_PEER_ID", "file_type": "concept", "source_file": "docs/configuration.md", "source_location": "Workspace", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Field wins over the environment variable; changing a peer id strands mail addressed to the old one."}, {"id": "docs_configuration_control_socket", "label": "Control socket path fallback", "file_type": "concept", "source_file": "docs/configuration.md", "source_location": "Top level", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unix socket paths cannot exceed 104 bytes, so a short hashed temp path is used."}, {"id": "docs_configuration_retry", "label": "retry configuration", "file_type": "concept", "source_file": "docs/configuration.md", "source_location": "retry", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Raising maxAttempts alone buys nothing because the request timeout bounds the whole request."}, {"id": "docs_configuration_breaker", "label": "breaker configuration", "file_type": "concept", "source_file": "docs/configuration.md", "source_location": "breaker", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_configuration_health_interval", "label": "healthIntervalMs", "file_type": "concept", "source_file": "docs/configuration.md", "source_location": "healthIntervalMs", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Github spends an API call per sweep; failover does not wait for a sweep because the breaker reacts to real failures."}, {"id": "docs_configuration_presence_interval", "label": "presenceIntervalMs", "file_type": "concept", "source_file": "docs/configuration.md", "source_location": "presenceIntervalMs", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A peer is gone after three missed intervals; on git each beacon is a commit that stays in history."}, {"id": "docs_configuration_inbox_orphan_ms", "label": "inboxOrphanMs", "file_type": "concept", "source_file": "docs/configuration.md", "source_location": "inboxOrphanMs", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Any peer may delete mail older than the window for a peer with no presence beacon; safe because all members already hold unrestricted delete. Message TTL is encrypted so it cannot be honoured from outside."}, {"id": "docs_configuration_adr_0006", "label": "ADR 0006 reaping orphaned inboxes", "file_type": "document", "source_file": "docs/configuration.md", "source_location": "inboxOrphanMs", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_configuration_concurrency", "label": "concurrency and lanes", "file_type": "concept", "source_file": "docs/configuration.md", "source_location": "concurrency", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default is 1 because concurrent handlers finish out of order; a full lane leaves messages unread in the inbox until it has room."}, {"id": "docs_configuration_enrollment", "label": "enrollment.requireApproval", "file_type": "concept", "source_file": "docs/configuration.md", "source_location": "enrollment", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Approvals are per machine and only gate rotations this peer performs; revoking alone changes nothing until the next rotation."}, {"id": "docs_configuration_transport_filesystem", "label": "filesystem transport", "file_type": "concept", "source_file": "docs/configuration.md", "source_location": "filesystem", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "forcePolling exists because fs.watch events are unreliable on network filesystems."}, {"id": "docs_configuration_transport_git", "label": "git transport", "file_type": "concept", "source_file": "docs/configuration.md", "source_location": "git", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Compaction force-pushes under a compare-and-swap lease so concurrent writes are not lost; protected branches need compactAfterCommits 0."}, {"id": "docs_configuration_transport_github", "label": "github transport", "file_type": "concept", "source_file": "docs/configuration.md", "source_location": "github", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A thin layer that resolves the clone url through gh and delegates to git; auth is whatever gh has, so dead-drop never sees a token."}, {"id": "docs_configuration_transport_memory", "label": "memory transport", "file_type": "concept", "source_file": "docs/configuration.md", "source_location": "memory", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_configuration_policy", "label": "policy modes: score, failover, parallel", "file_type": "concept", "source_file": "docs/configuration.md", "source_location": "Policy", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only writes are affected; receiving reads every transport, so a message written on a healthy transport is still found. Parallel costs a write per transport but is the most available."}, {"id": "docs_configuration_exposures", "label": "exposures (http and static)", "file_type": "concept", "source_file": "docs/configuration.md", "source_location": "Exposures", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_configuration_streaming", "label": "exposure streaming", "file_type": "concept", "source_file": "docs/configuration.md", "source_location": "Streaming a response body", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "timeoutMs stops applying once streaming because it would defeat open event streams; maxDurationMs bounds them instead. Old callers get buffered bodies so mixed versions degrade gracefully."}, {"id": "docs_configuration_allow_peers", "label": "allowPeers", "file_type": "concept", "source_file": "docs/configuration.md", "source_location": "Exposures", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A guardrail, not a security boundary, since any secret holder can claim any peer id."}], "edges": [{"source": "docs_configuration_inbox_orphan_ms", "target": "docs_configuration_adr_0006", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/configuration.md", "source_location": "inboxOrphanMs", "weight": 1}, {"source": "docs_configuration", "target": "docs_configuration_parse_runtime_config", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/configuration.md", "source_location": "intro", "weight": 1}, {"source": "docs_configuration_concurrency", "target": "docs_configuration_streaming", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.5, "source_file": "docs/configuration.md", "source_location": null, "weight": 1}, {"source": "docs_configuration_retry", "target": "docs_configuration_breaker", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 0.85, "source_file": "docs/configuration.md", "source_location": null, "weight": 1}, {"source": "docs_configuration_policy", "target": "docs_configuration_breaker", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.9, "source_file": "docs/configuration.md", "source_location": "A worked example", "weight": 1}, {"source": "docs_configuration_policy", "target": "docs_configuration_transport_filesystem", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.9, "source_file": "docs/configuration.md", "source_location": "A worked example", "weight": 1}, {"source": "docs_configuration_policy", "target": "docs_configuration_transport_github", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.9, "source_file": "docs/configuration.md", "source_location": "A worked example", "weight": 1}, {"source": "docs_configuration_transport_github", "target": "docs_configuration_transport_git", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/configuration.md", 