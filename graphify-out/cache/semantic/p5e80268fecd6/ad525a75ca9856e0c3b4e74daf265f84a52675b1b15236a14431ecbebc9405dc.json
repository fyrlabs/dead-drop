{"nodes": [{"id": "docs_configuration", "label": "Configuration reference", "file_type": "document", "source_file": "docs/configuration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_configuration_config_references", "label": "${env:} and ${file:} references", "file_type": "concept", "source_file": "docs/configuration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Expanded in a single pass so expanded values are data, not a second lookup. ${file:} strips whitespace because a trailing newline would change the key."}, {"id": "docs_configuration_replace_me_placeholder", "label": "REPLACE-ME placeholder", "file_type": "concept", "source_file": "docs/configuration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No default can guess the shared location. The old local-folder default let two machines start cleanly and never see each other."}, {"id": "docs_configuration_peerid", "label": "peerId field", "file_type": "concept", "source_file": "docs/configuration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "init writes it explicitly so the address is visible in the file. Hostname-fallback differences stay as they are because changing them would strand mail."}, {"id": "docs_configuration_enrollment", "label": "enrollment.requireApproval", "file_type": "concept", "source_file": "docs/configuration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Off by default so joining stays one command. On, a peer reads nothing new until a human compares its fingerprint out of band."}, {"id": "docs_configuration_retry", "label": "retry config", "file_type": "concept", "source_file": "docs/configuration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Raising maxAttempts alone does nothing because the request timeout bounds the whole request. Raise requestTimeoutMs along with it."}, {"id": "docs_configuration_breaker", "label": "breaker config", "file_type": "concept", "source_file": "docs/configuration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_configuration_healthintervalms", "label": "healthIntervalMs", "file_type": "concept", "source_file": "docs/configuration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On github every health sweep costs an API call. Failover itself runs off the breaker, so a longer interval only delays reporting."}, {"id": "docs_configuration_presenceintervalms", "label": "presenceIntervalMs", "file_type": "concept", "source_file": "docs/configuration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On git transports every beacon is a commit and push, so a short interval has a real cost."}, {"id": "docs_configuration_inboxorphanms", "label": "inboxOrphanMs", "file_type": "concept", "source_file": "docs/configuration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Requires both message age and an absent beacon, so a peer that is only offline keeps its mail. It is separate from the per-message TTL because the TTL sits in the encrypted header. It grants no new privilege because every member already has delete."}, {"id": "docs_configuration_concurrency", "label": "concurrency (handler pool)", "file_type": "concept", "source_file": "docs/configuration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Defaults to 1 because concurrent handlers answer out of order. It is a pool rather than a batch, so later messages start as soon as a slot frees."}, {"id": "docs_configuration_git_transport", "label": "git transport", "file_type": "concept", "source_file": "docs/configuration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A working tree has one writer, so a second runtime clones into <workDir>.peers/. The branch is compacted under a compare-and-swap lease so a concurrent write is not lost."}, {"id": "docs_configuration_github_transport", "label": "github transport", "file_type": "concept", "source_file": "docs/configuration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A thin layer that resolves the clone url through gh and delegates to git, so dead-drop never sees a token."}, {"id": "docs_configuration_filesystem_transport", "label": "filesystem transport", "file_type": "concept", "source_file": "docs/configuration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "forcePolling exists because fs.watch events are silently unreliable on network filesystems."}, {"id": "docs_configuration_memory_transport", "label": "memory transport", "file_type": "concept", "source_file": "docs/configuration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_configuration_policy", "label": "Transport policy (score/failover/parallel)", "file_type": "concept", "source_file": "docs/configuration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Policy affects only writes, and reads poll every transport. Failover honours operator order because a cheaper or slower transport placed first is deliberate. Parallel is for peers that cannot reach the same transports, and every write costs one per transport."}, {"id": "docs_configuration_exposures", "label": "Exposures", "file_type": "concept", "source_file": "docs/configuration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_configuration_streaming", "label": "Exposure streaming config", "file_type": "concept", "source_file": "docs/configuration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "timeoutMs stops applying once a body is streaming, and maxDurationMs bounds it instead. Older callers get buffered bodies, so a mixed-version workspace degrades instead of breaking."}, {"id": "docs_configuration_allowpeers", "label": "allowPeers", "file_type": "concept", "source_file": "docs/configuration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "It matches the configured peerId rather than the per-process mailbox address. It is a guardrail and not a security boundary, because any secret holder can claim any peer id."}, {"id": "docs_configuration_polling", "label": "polling intervals", "file_type": "concept", "source_file": "docs/configuration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_configuration_requesttimeoutms", "label": "requestTimeoutMs", "file_type": "concept", "source_file": "docs/configuration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}], "edges": [{"source": "docs_configuration_streaming", "target": "docs_configuration_exposures", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/configuration.md", "source_location": null, "weight": 1}, {"source": "docs_configuration_inboxorphanms", "target": "changelog_branch_compaction", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 0.9, "source_file": "docs/configuration.md", "source_location": null, "weight": 0.9}, {"source": "docs_configuration_retry", "target": "docs_configuration_requesttimeoutms", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/configuration.md", "source_location": null, "weight": 1}, {"source": "docs_configuration_inboxorphanms", "target": "docs_configuration_presenceintervalms", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/configuration.md", "source_location": null, "weight": 1}, {"source": "docs_configuration_github_transport", "target": "docs_configuration_git_transport", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/configuration.md", "source_location": null, "weight": 1}, {"source": "docs_configuration_policy", "target": "docs_configuration_breaker", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/configuration.md", "source_location": null, "weight": 1}, {"source": "docs_configuration_healthintervalms", "target": "docs_configuration_breaker", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 0.9, "source_file": "docs/configuration.md", "source_location": null, "weight": 0.9}, {"source": "docs_configuration_healthintervalms", "target": "docs_configuration_github_transport", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.9, "source_file": "docs/configuration.md", "source_location": null, "weight": 0.9}, {"source": "docs_configuration_allowpeers", "target": "docs_configuration_peerid", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/configuration.md", "source_location": null, "weight": 1}, {"source": "docs_configuration_allowpeers", "target": "docs_configuration_exposures", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/configuration.md", "source_location": null, "weight": 1}], "hyperedges": [{"id": "built_in_transports", "label": "Built-in transports", "nodes": ["docs_configuration_filesystem_transport", "docs_configuration_git_transport", "docs_configuration_github_transport", "docs_configuration_memory_transport"], "relation": "implement", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/configuration.md"}, {"id": "transport_failover_machinery", "label": "Transport failover and health machinery", "nodes": ["docs_configuration_policy", "docs_configuration_breaker", "docs_configuration_retry", "docs_configuration_healthintervalms", "docs_configuration_requesttimeoutms"], "relation": "participate_in", "confidence": "EXTRACTED", "confidence_score": 0.9, "source_file": "docs/configuration.md"}]}