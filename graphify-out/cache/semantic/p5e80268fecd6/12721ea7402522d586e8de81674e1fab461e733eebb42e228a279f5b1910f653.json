{"nodes": [{"id": "docs_operations", "label": "Operations guide", "file_type": "document", "source_file": "docs/operations.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_operations_configuration", "label": "Configuration (deaddrop.config.json)", "file_type": "concept", "source_file": "docs/operations.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Relative paths resolve against the config file's directory, not the working directory. An unset ${env:NAME} is a hard error rather than a silent empty string. peerId should be set explicitly if hostnames are unstable because a peer id is a mailbox address and changing it strands undelivered messages."}, {"id": "docs_operations_startup_and_shutdown", "label": "Startup independent of transports, graceful shutdown", "file_type": "concept", "source_file": "docs/operations.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Control plane and connect port bind whether or not a transport is reachable, so requests fail with NO_TRANSPORT_AVAILABLE instead of a closed port. Only one beacon is in flight and it is abandoned after the expiry window (three intervals, 90s) because unbounded beacons accumulate as extra writers and slow a slow backend further."}, {"id": "docs_operations_presence_beacon", "label": "Presence beacon", "file_type": "concept", "source_file": "docs/operations.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_operations_queued_depth", "label": "ddrop queues (queued depth)", "file_type": "concept", "source_file": "docs/operations.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reads object keys only, since keys carry peer name and a time-sortable message id in the clear by design; nothing is fetched, decrypted or consumed. Age comes from the sender's clock via the message id because store transports are not required to report modification time."}, {"id": "docs_operations_dashboard", "label": "ddrop dashboard", "file_type": "concept", "source_file": "docs/operations.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Read-only with no publish/call/expose/cancel/retry route, which makes a browser-reachable port an acceptable trade rather than a second door into the workspace. Starts no runtime and is a client of the control socket. Binds 127.0.0.1 only, checks Host header, and fails on a port in use."}, {"id": "docs_operations_adr_0004", "label": "ADR 0004: dashboard binds TCP and holds no runtime", "file_type": "document", "source_file": "docs/operations.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_operations_proxy_latency", "label": "Proxy latency on a polled transport", "file_type": "concept", "source_file": "docs/operations.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Git and github transports cannot watch so messages are found by polling. freshnessMs gates the git fetch and dominates latency (5000 default gives a ten-second floor). The default is 5000 so it is safe for a peer nobody turns off for a month; 2000 is recommended for GitHub because one fetch per second per peer against a shared remote is rude."}, {"id": "docs_operations_polling_maxintervalms", "label": "polling.maxIntervalMs", "file_type": "concept", "source_file": "docs/operations.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_operations_freshnessms", "label": "freshnessMs", "file_type": "concept", "source_file": "docs/operations.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_operations_presenceintervalms", "label": "presenceIntervalMs", "file_type": "concept", "source_file": "docs/operations.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On a git transport every beacon is a commit and a push, so two idle peers at the 30000 default write a few thousand commits a day."}, {"id": "docs_operations_stream_cancel_latency", "label": "Stream cancel latency over polled transport", "file_type": "concept", "source_file": "docs/operations.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_operations_metrics", "label": "Prometheus metrics", "file_type": "concept", "source_file": "docs/operations.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_operations_traces", "label": "Traces (ddrop trace)", "file_type": "concept", "source_file": "docs/operations.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Buffer holds the most recent 500 finished spans and is memory-only, so it is for debugging a problem happening now, not after the fact."}, {"id": "docs_operations_troubleshooting", "label": "Troubleshooting", "file_type": "concept", "source_file": "docs/operations.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dead letters are never removed automatically, which is intentional."}, {"id": "docs_operations_backup_and_dr", "label": "Backup and disaster recovery", "file_type": "concept", "source_file": "docs/operations.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The transport store holds only undelivered messages, so losing it loses in-flight mail, not state. The workspace secret is what needs backing up."}, {"id": "docs_operations_workspace_secret", "label": "Workspace secret", "file_type": "concept", "source_file": "docs/operations.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_operations_configuration_md", "label": "Configuration reference", "file_type": "document", "source_file": "docs/operations.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_operations_security_model", "label": "Security model", "file_type": "document", "source_file": "docs/operations.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}], "edges": [{"source": "docs_operations", "target": "docs_operations_configuration", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/operations.md", "source_location": null, "weight": 1}, {"source": "docs_operations", "target": "docs_operations_startup_and_shutdown", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/operations.md", "source_location": null, "weight": 1}, {"source": "docs_operations", "target": "docs_operations_queued_depth", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/operations.md", "source_location": null, "weight": 1}, {"source": "docs_operations", "target": "docs_operations_dashboard", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/operations.md", "source_location": null, "weight": 1}, {"source": "docs_operations", "target": "docs_operations_proxy_latency", "relation": "references", "con