{"nodes": [{"id": "changelog", "label": "dead-drop Changelog", "file_type": "document", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "changelog_lane_concurrency", "label": "Per-channel and per-service handler lanes", "file_type": "document", "source_file": "CHANGELOG.md", "source_location": "Unreleased", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One slow service should not hold up the others, so each channel or service can have its own handler limit."}, {"id": "changelog_workspace_handle", "label": "workspace.handle(channel, handler, { concurrency })", "file_type": "code", "source_file": "CHANGELOG.md", "source_location": "Unreleased", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "changelog_workspace_service", "label": "workspace.service(name, methods, { concurrency })", "file_type": "code", "source_file": "CHANGELOG.md", "source_location": "Unreleased", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "changelog_responses_bypass_handler_slots", "label": "Responses no longer wait for a handler slot", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "Unreleased", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "At concurrency 1 a handler calling another peer timed out because the reply needed the slot the handler was holding."}, {"id": "changelog_pool_concurrency_fix", "label": "Concurrency as a slot pool (0.16.1)", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.16.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Concurrency previously only ran messages together when one poll found them together, so a long handler blocked later arrivals."}, {"id": "changelog_git_worktree_serialisation", "label": "Serialised git working-tree operations", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.16.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reads reset the working tree between a concurrent write's commit and push, causing a discarded-push warning."}, {"id": "changelog_streaming_exposure", "label": "Streaming response bodies for exposures", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.16.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Buffering whole responses blocked server-sent events and forced large files to fit in memory on both peers."}, {"id": "changelog_content_encoding_fix", "label": "Proxy asks target not to compress", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.15.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Decompressed bytes were labelled content-encoding: gzip, causing ERR_CONTENT_DECODING_FAILED in browsers."}, {"id": "changelog_polling_backoff_fix", "label": "Faster proxied requests via polling while awaiting reply", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.15.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A peer awaiting a reply backed off polling to 15s as if idle."}, {"id": "changelog_ddrop_rotate", "label": "ddrop rotate", "file_type": "code", "source_file": "CHANGELOG.md", "source_location": "0.13.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Removing a peer should not require giving everyone a new secret."}, {"id": "changelog_ddrop_peer", "label": "ddrop peer list/approve/revoke", "file_type": "code", "source_file": "CHANGELOG.md", "source_location": "0.13.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "changelog_enrollment_require_approval", "label": "enrollment.requireApproval", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.13.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "For people who do not trust the storage their peers meet through; approval records the fingerprint so a changed key loses approval."}, {"id": "changelog_inbox_orphan_reaping", "label": "Orphaned inbox reaping (inboxOrphanMs)", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.10.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only the addressee empties its inbox, so mail for departed peers was never reclaimed and compaction did not help."}, {"id": "changelog_git_branch_compaction", "label": "Data branch compaction (compactAfterCommits)", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.8.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every message left a commit forever, slowing joins and nearing host size limits."}, {"id": "changelog_parallel_policy", "label": "policy.mode parallel now implemented", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.11.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Needed when peers cannot all reach the same transports; the mode was previously accepted and ignored."}, {"id": "changelog_transport_sdk", "label": "@fyrlabs/dead-drop-transport-sdk", "file_type": "code", "source_file": "CHANGELOG.md", "source_location": "0.2.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stable contract versioned independently so third-party adapters keep working across dead-drop majors."}, {"id": "changelog_deaddrop_error_brand", "label": "DeadDropError.is symbol brand check", "file_type": "code", "source_file": "CHANGELOG.md", "source_location": "0.2.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "instanceof fails across two copies of transport-sdk, causing permanent errors like UNAUTHORIZED to be re-wrapped as retryable INTERNAL."}, {"id": "changelog_package_consolidation", "label": "Ten packages consolidated into @fyrlabs/dead-drop", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.2.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Layering is now enforced by an eslint no-restricted-imports rule instead of package boundaries."}, {"id": "changelog_ddrop_init", "label": "ddrop init", "file_type": "code", "source_file": "CHANGELOG.md", "source_location": "0.4.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Generates a working config: secret file, explicit peer id, and REPLACE-ME for the shared location so two peers cannot silently diverge."}, {"id": "changelog_ddrop_dashboard", "label": "ddrop dashboard", "file_type": "code", "source_file": "CHANGELOG.md", "source_location": "0.7.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "changelog_ddrop_queues", "label": "ddrop queues", "file_type": "code", "source_file": "CHANGELOG.md", "source_location": "0.6.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "changelog_request_timeout_bounds_whole_request", "label": "Request timeout bounds the whole request", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.3.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Previously only the reply wait was bounded, so a 15s timeout could wait two minutes during transport failures."}, {"id": "changelog_allow_peers", "label": "allowPeers matches configured peerId", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.3.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "It matched the per-process reply address for ddrop connect, so hand-written lists denied everyone."}, {"id": "changelog_git_workdir_claim", "label": "Second runtime clones into workDir.peers", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.2.5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Git does not support two runtimes sharing one working tree."}, {"id": "changelog_push_published_check", "label": "Push counted as published only when on remote-tracking branch", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.2.4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "git push exits 0 with Everything up-to-date when the commit is no longer HEAD, silently dropping messages."}, {"id": "changelog_envelope_encryption", "label": "AES-256-GCM whole-envelope encryption", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.1.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Object keys are deliberately readable so operators can inspect a repository; only frame contents are encrypted."}, {"id": "changelog_transports", "label": "Built-in transports: filesystem, git, github, memory", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.1.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}], "edges": [{"source": "changelog_lane_concurrency", "target": "changelog_workspace_handle", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "CHANGELOG.md", "source_location": "Unreleased", "weight": 1}, {"source": "changelog_lane_concurrency", "target": "changelog_workspace_service", "relation": "r