{"nodes": [{"id": "changelog", "label": "dead-drop CHANGELOG", "file_type": "document", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Versions track @fyrlabs/dead-drop; the transport SDK versions independently and its changes are called out explicitly."}, {"id": "changelog_dead_drop_package", "label": "@fyrlabs/dead-drop", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "changelog_transport_sdk", "label": "@fyrlabs/dead-drop-transport-sdk", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.2.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kept as a separate package with its own semver (1.0.0) so a third-party adapter does not depend on the whole runtime and keeps working across dead-drop majors."}, {"id": "changelog_two_package_layout", "label": "Two-package layout with subpath exports", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.2.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Collapsed ten packages into two; everything except the transport contract lives in @fyrlabs/dead-drop under /sdk, /runtime, /core, /protocol, /cli, /transports/<name>."}, {"id": "changelog_eslint_layering_rule", "label": "eslint no-restricted-imports layering", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.2.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces package boundaries as the layering guard: protocol imports nothing above it, core never names a transport, a transport sees only protocol and transport SDK."}, {"id": "changelog_deaddroperror", "label": "DeadDropError", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.2.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Moved into transport-sdk because adapters must throw it and the transport manager reads its retryable flag. DeadDropError.is brand-checks a Symbol.for key instead of instanceof so errors from two copies of transport-sdk are still recognised; otherwise UNAUTHORIZED was re-wrapped as retryable INTERNAL and retried forever."}, {"id": "changelog_conformance_suite", "label": "Transport conformance suite", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.6.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Checks that listing a prefix returns nested keys; an adapter that did not would report every queue as empty."}, {"id": "changelog_static_import_thunks", "label": "Built-in transports loaded via static import() thunks", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.2.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A dynamic import(variable) cannot be resolved by bundlers or test runners, so the old form only worked under plain Node."}, {"id": "changelog_filesystem_transport", "label": "filesystem transport", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.1.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "changelog_git_transport", "label": "git transport", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.1.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "changelog_github_transport", "label": "github transport (gh CLI)", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.1.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "changelog_memory_transport", "label": "memory transport", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.1.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "changelog_working_tree_serialization", "label": "Serialized git working-tree operations", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.16.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reads reset the working tree between a concurrent write's commit and push; serialising removes the 'push was discarded ... replaying' warning."}, {"id": "changelog_push_verification", "label": "Push confirmed via remote-tracking branch", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.2.4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "git push exits 0 with 'Everything up-to-date' when the commit is no longer HEAD, silently dropping messages when processes share a clone; a live GitHub run lost 10 of 50 requests."}, {"id": "changelog_per_runtime_clone", "label": "Per-runtime clone under <workDir>.peers", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.2.5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "git does not support two processes sharing a working tree; ddrop connect builds a runtime from the same config as the running peer."}, {"id": "changelog_workdir_isolation", "label": "git workDir no longer takes over enclosing repo", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.3.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "changelog_branch_compaction", "label": "Data branch compaction (compactAfterCommits)", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.8.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every message left a commit forever, slowing joins and approaching host size limits; past 500 commits the branch is squashed. Disable on force-push-protected branches."}, {"id": "changelog_concurrency", "label": "Workspace concurrency (sliding handler pool)", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.5.0, 0.16.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Removes head-of-line blocking behind a slow handler at the cost of out-of-order replies. 0.16.1 starts a message as soon as a slot frees rather than only batching messages found in one poll."}, {"id": "changelog_streaming_exposure", "label": "Streaming exposure responses", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.16.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Supports SSE and unbounded bodies without buffering whole in memory; lifts the 0.1.0 32 MiB buffered-response limitation. Opt in per exposure; a reader that stops reading stops the sender."}, {"id": "changelog_response_cap", "label": "32 MiB buffered response cap", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.1.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "changelog_content_encoding_fix", "label": "Proxy strips content-encoding / asks target not to compress", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.15.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Browsers failed with ERR_CONTENT_DECODING_FAILED because decompressed bytes were still labelled gzip; wire size is unchanged since frames are compressed a layer down."}, {"id": "changelog_adaptive_polling", "label": "Adaptive polling (polling.maxIntervalMs)", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.15.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A peer awaiting a reply no longer backs off to 15s; measured 18s to 5s per request on local git, 1.2s with lowered maxIntervalMs and freshnessMs. Idle peers back off as before."}, {"id": "changelog_identity_file_race", "label": "Identity file write race fix", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.14.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "changelog_deaddrop_peer_id", "label": "DEADDROP_PEER_ID env var", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.14.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "changelog_ddrop_init", "label": "ddrop init", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.4.0, 0.9.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Writes a working config: generated secret file, explicit peerId to avoid hostname collisions, REPLACE-ME for the shared location. --github and --secret (stdin via '-') make GitHub setup and joining one command each."}, {"id": "changelog_replace_me_placeholder", "label": "REPLACE-ME placeholder check", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.4.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "changelog_file_interpolation", "label": "${file:PATH} config interpolation", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.4.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lets a config be committed with the secret beside it rather than inside it."}, {"id": "changelog_key_rotation", "label": "ddrop rotate (per-peer key wrapping)", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.13.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Removing a peer no longer requires redistributing a secret: the new key is wrapped for each peer's own published key; excluded peers cannot read later messages, earlier ones stay readable."}, {"id": "changelog_peer_list", "label": "ddrop peer list", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.13.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "changelog_enrollment_approval", "label": "enrollment.requireApproval / peer approve / peer revoke", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.13.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "For users who do not trust shared storage; approval pins a fingerprint so a changed key loses approval instead of inheriting it."}, {"id": "changelog_ddrop_expose", "label": "ddrop expose", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.1.0, 0.12.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "changelog_ddrop_connect", "label": "ddrop connect", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.1.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "changelog_config_validation", "label": "polling/policy config validation", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.12.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Resolves the 0.1.0 known limitation that these sub-fields were not type-checked at load."}, {"id": "changelog_parallel_policy", "label": "policy.mode parallel", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.11.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "For peers that cannot all reach the same transports; costs a write (a commit and push on git/GitHub) per transport per message."}, {"id": "changelog_multi_transport_failover", "label": "Multi-transport scoring, retry, circuit breaker, failover", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.1.0, 0.3.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "0.3.0: retry no longer backs off in front of an open breaker, so failover takes seconds not minutes."}, {"id": "changelog_retry_breaker_config", "label": "retry and breaker workspace config", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.4.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Raising retry.maxAttempts alone buys nothing because the request timeout bounds the whole request; raise requestTimeoutMs with it."}, {"id": "changelog_request_timeout", "label": "requestTimeoutMs bounds whole request", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.3.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Previously only the reply wait was bounded, so a 15s request could take two minutes during transport failures."}, {"id": "changelog_health_presence_intervals", "label": "healthIntervalMs / presenceIntervalMs", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.5.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tunable because probes and beacons cost an API call on github and a commit on git."}, {"id": "changelog_presence_beacons", "label": "Presence beacons", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.3.1, 0.10.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only one published at a time and abandoned once too old, so a slow backend is not pushed into failing by its own presence records."}, {"id": "changelog_inbox_orphan_cleanup", "label": "Orphaned inbox cleanup (inboxOrphanMs)", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.10.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mail for departed peers was never reclaimed (60 MB in one squashed trial repo). Deleted only when older than 7 days and the recipient has stopped publishing presence, so a briefly offline peer keeps its mail."}, {"id": "changelog_ddrop_dashboard", "label": "ddrop dashboard", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.7.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Read-only, reads the same control socket as ddrop status; exposes workspace metadata locally while open, so run it on demand rather than as a service."}, {"id": "changelog_ddrop_queues", "label": "ddrop queues / client.queues()", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.6.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "changelog_ddrop_discover", "label": "ddrop discover / client.peers()", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.6.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Now exits 1 naming the failed transport so an unreachable workspace no longer looks empty."}, {"id": "changelog_allow_peers", "label": "allowPeers", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.3.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Matches the configured peerId, not the per-process reply address that appears in no config file."}, {"id": "changelog_identity_address_split", "label": "Peer identity separated from mailbox address", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.3.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lets a short-lived session take its own address without losing who it is."}, {"id": "changelog_control_socket_path", "label": "Control socket short-path fallback", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.2.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unix socket paths cannot exceed 104 bytes; falls back to a hashed path under the temp dir, as Windows named pipes already did."}, {"id": "changelog_version_module", "label": "Single version module from package manifest", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.2.1, 0.2.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A hard-coded 0.1.0 literal leaked into --version, ddrop status and /health; a test now fails the build on hard-coded versions."}, {"id": "changelog_envelope_encryption", "label": "AES-256-GCM envelope encryption", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.1.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "changelog_cleartext_object_keys", "label": "Readable object keys ws/<workspace>/inbox/<peer>/<id>.ddf", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.2.3, 0.4.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deliberately readable so an operator can understand a repository; earlier notes and README falsely claimed names never appear in clear text."}, {"id": "changelog_at_least_once_delivery", "label": "At-least-once delivery over object storage", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.1.0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Delete-as-acknowledgement, redelivery with backoff, dead letters, dedup; handlers must be idempotent since duplicates are suppressed, not prevented."}, {"id": "changelog_non_retryable_health_logging", "label": "Non-retryable health failures logged at error", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "0.2.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "changelog_e2e_script", "label": "scripts/e2e.sh", "file_type": "code", "source_file": "CHANGELOG.md", "source_location": "0.2.6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One suite with fast (CI) and live (GitHub, opt-in) tiers, replacing the two older check scripts."}, {"id": "changelog_github_live_check", "label": "scripts/github-live-check.sh", "file_type": "code", "source_file": "CHANGELOG.md", "source_location": "0.2.4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "changelog_two_peer_check", "label": "scripts/two-peer-check.sh", "file_type": "code", "source_file": "CHANGELOG.md", "source_location": "0.2.1, 0.2.4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "changelog_release_checklist", "label": ".github/RELEASE_CHECKLIST.md", "file_type": "document", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_configuration", "label": "docs/configuration.md", "file_type": "document", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_operations", "label": "docs/operations.md", "file_type": "document", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "auth