{"nodes": [{"id": "docs_vision", "label": "Vision", "file_type": "document", "source_file": "docs/vision.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_vision_problem", "label": "The problem: shared thing as transport", "file_type": "concept", "source_file": "docs/vision.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deploying a broker, tunnel or relay costs more than the problem; machines usually already share an authenticated, firewall-permitted git repo, folder or object store."}, {"id": "docs_vision_transport_independence", "label": "Transport is an implementation detail", "file_type": "concept", "source_file": "docs/vision.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nothing above the transport manager may name a transport, otherwise transport independence would be a slogan rather than a property."}, {"id": "docs_vision_delivery_once", "label": "Delivery is implemented once", "file_type": "concept", "source_file": "docs/vision.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Asking each adapter author to reinvent polling, acknowledgement, deduplication and redelivery would yield many subtly different delivery bugs in packages the project does not control, so a store adapter implements four methods and the runtime supplies the rest."}, {"id": "docs_vision_proxy_mode", "label": "Proxy mode for unchanged applications", "file_type": "concept", "source_file": "docs/vision.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_vision_honest_guarantees", "label": "Say what is true (at-least-once, hostile storage)", "file_type": "concept", "source_file": "docs/vision.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_vision_roadmap", "label": "Roadmap: more transports, GitHub token path, plugin ecosystem", "file_type": "concept", "source_file": "docs/vision.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GitLab, Bitbucket and Azure DevOps already work via the git transport by remote url, so they earn dedicated packages only if their APIs offer something git does not."}, {"id": "docs_vision_ghclient_seam", "label": "GhClient seam (token path for GitHub)", "file_type": "concept", "source_file": "docs/vision.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Authentication is delegated entirely to gh today; a REST path would remove that dependency where installing gh is the hard part."}, {"id": "docs_vision_non_goals", "label": "Non-goals", "file_type": "concept", "source_file": "docs/vision.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Not a broker (git round trips cost seconds), not a way around security policy, not a service mesh, not a database."}, {"id": "docs_vision_history", "label": "History: single send/receive/ack interface replaced by two-kind contract", "file_type": "concept", "source_file": "docs/vision.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Implementation showed the single interface was the wrong shape for the target backends."}, {"id": "docs_vision_adr_0001", "label": "ADR 0001: store and native transports", "file_type": "document", "source_file": "docs/vision.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_vision_architecture", "label": "Arch