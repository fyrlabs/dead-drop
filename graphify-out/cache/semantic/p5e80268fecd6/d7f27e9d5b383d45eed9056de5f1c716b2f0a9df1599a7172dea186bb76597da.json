{"nodes": [{"id": "changelog", "label": "dead-drop CHANGELOG", "file_type": "document", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "changelog_dead_drop_package", "label": "@fyrlabs/dead-drop", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "0.2.0 collapsed ten packages into one, reachable by subpaths (/sdk, /runtime, /core, /protocol, /cli, /transports/<name>)."}, {"id": "changelog_transport_sdk", "label": "@fyrlabs/dead-drop-transport-sdk", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Versions independently from the runtime because the contract is settled and should stay stable, so third-party adapters keep working across dead-drop majors."}, {"id": "changelog_deaddrop_error", "label": "DeadDropError", "file_type": "code", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DeadDropError.is brand-checks a Symbol.for registry key instead of instanceof, so errors are recognised across duplicate copies of transport-sdk. Otherwise a permanent failure like UNAUTHORIZED was re-wrapped as retryable INTERNAL."}, {"id": "changelog_layering_lint_rule", "label": "Layering enforced by eslint no-restricted-imports", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Package boundaries used to enforce layering; after the merge into one package a lint rule does: protocol imports nothing above it, core never names a transport, transports see only protocol and transport SDK."}, {"id": "changelog_transports", "label": "Transports (filesystem, git, github, memory)", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "changelog_git_transport", "label": "git and github transports", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "changelog_branch_compaction", "label": "Data branch compaction (compactAfterCommits)", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every message left a commit forever, slowing joins and nearing host size limits; past 500 commits one peer replaces the branch with a single commit. Cannot work on force-push-protected branches."}, {"id": "changelog_push_verification", "label": "Push published only when commit is on remote-tracking branch", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "git push exits 0 with 'Everything up-to-date' when the commit is no longer HEAD, which happens when a second process shares the clone; a live run lost 10 of 50 requests."}, {"id": "changelog_work_dir_isolation", "label": "Per-runtime git clone under workDir.peers", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Git does not support two runtimes sharing one working tree; the first claims workDir, later ones clone into a peers subdirectory."}, {"id": "changelog_working_tree_serialisation", "label": "Serialised git working-tree operations", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "changelog_concurrency_lanes", "label": "Handler concurrency lanes", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per-channel and per-service concurrency stops one slow service blocking others. Responses no longer wait for a handler slot, so a handler can call another peer at concurrency 1."}, {"id": "changelog_concurrency_setting", "label": "concurrency workspace setting", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Raising it removes head-of-line blocking at the cost of out-of-order answers; default 1."}, {"id": "changelog_streaming_exposure", "label": "Streaming response bodies", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces whole-body buffering (32 MiB cap) so SSE and large files work; a caller that stops reading stops the sender."}, {"id": "changelog_response_buffer_cap", "label": "32 MiB buffered response cap", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "changelog_ddrop_expose", "label": "ddrop expose", "file_type": "code", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "changelog_ddrop_connect", "label": "ddrop connect", "file_type": "code", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "changelog_proxy_mode", "label": "Proxy mode", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "changelog_content_encoding_fix", "label": "Proxy asks target not to compress", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Decompressed bytes were labelled content-encoding: gzip causing ERR_CONTENT_DECODING_FAILED; nothing grows on the wire because frames are already compressed a layer down."}, {"id": "changelog_polling_backoff", "label": "Adaptive polling and reply-wait backoff", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A peer waiting for a reply used to back off to 15s as if idle; fixed so proxied requests over git/github are several times faster (18s to 5s, 1.2s with tuned settings)."}, {"id": "changelog_ddrop_init", "label": "ddrop init", "file_type": "code", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Writes a working config: generated secret file, explicit peer id, and a REPLACE-ME placeholder for the shared location so two peers cannot silently diverge."}, {"id": "changelog_config_file_substitution", "label": "Config ${file:PATH} and ${env:NAME} substitution", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "changelog_peer_id", "label": "peerId and DEADDROP_PEER_ID", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Peer id was both mailbox address and identity; split so a short-lived session can take its own address. allowPeers matches the configured peerId."}, {"id": "changelog_key_rotation", "label": "ddrop rotate and per-peer key wrapping", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Removing a peer without distributing a new shared secret: each peer publishes its own key, and rotation wraps the new key for the peers who may still read."}, {"id": "changelog_enrollment_approval", "label": "Enrollment requireApproval and ddrop peer approve/revoke", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "For untrusted storage. Approval records a key fingerprint compared out of band, so a changed key stops being approved."}, {"id": "changelog_ddrop_peer_list", "label": "ddrop peer list", "file_type": "code", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "changelog_ddrop_discover", "label": "ddrop discover", "file_type": "code", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "changelog_ddrop_queues", "label": "ddrop queues", "file_type": "code", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reads object keys only: nothing decrypted or consumed."}, {"id": "changelog_ddrop_dashboard", "label": "ddrop dashboard", "file_type": "code", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Read-only, starts no runtime, reads the same control socket as ddrop status; binds 127.0.0.1:7373."}, {"id": "changelog_control_socket", "label": "Control socket", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unix socket paths are limited to 104 bytes, so deep data dirs fall back to a short hashed path under the temp directory."}, {"id": "changelog_policy_parallel", "label": "policy mode parallel", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Writes every message and beacon to all transports; costs a write per transport per message."}, {"id": "changelog_multi_transport_failover", "label": "Multi-transport health scoring, retry, breaker and failover", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Retry no longer backs off in front of an already-open breaker, so failover takes seconds."}, {"id": "changelog_retry_breaker_config", "label": "retry and breaker config", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Raising retry.maxAttempts alone buys nothing since the request timeout bounds the whole request."}, {"id": "changelog_request_timeout", "label": "requestTimeoutMs bounds whole request", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Previously guarded only the reply wait, so sends ran unbounded during transport failures."}, {"id": "changelog_presence_beacons", "label": "Presence beacons", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only one is published at a time and abandoned when too old, so a slow backend is not pushed into failing by its own beacons."}, {"id": "changelog_inbox_orphan_expiry", "label": "Orphaned inbox expiry (inboxOrphanMs)", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only the addressee empties its inbox, so mail for departed peers was never reclaimed. Deleted when older than 7 days and the peer has stopped publishing a beacon."}, {"id": "changelog_health_intervals", "label": "healthIntervalMs and presenceIntervalMs", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "changelog_config_validation", "label": "Config load-time validation", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "changelog_encryption", "label": "AES-256-GCM envelope encryption", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Object keys stay readable on purpose so an operator can understand a repository; contents and envelope header are encrypted."}, {"id": "changelog_security_model_doc", "label": "docs/security-model.md", "file_type": "document", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "changelog_delivery_semantics", "label": "At-least-once delivery", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Duplicates are suppressed, not prevented, so handlers must be safe to run twice."}, {"id": "changelog_observability", "label": "Observability (logs, metrics, tracing)", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A message id is its own trace id, so ddrop trace works with the id a timeout error returns."}, {"id": "changelog_version_module", "label": "Single version module", "file_type": "code", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One module reads the package manifest and a test fails the build if any source hard-codes a version."}, {"id": "changelog_conformance_suite", "label": "Transport conformance suite", "file_type": "code", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "changelog_e2e_script", "label": "scripts/e2e.sh", "file_type": "code", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "changelog_two_peer_check", "label": "scripts/two-peer-check.sh", "file_type": "code", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "changelog_github_live_check", "label": "scripts/github-live-check.sh", "file_type": "code", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "changelog_release_checklist", "label": ".github/RELEASE_CHECKLIST.md", "file_type": "document", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "ration