ct", "target": "docs_writing_a_transport_start_after", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/writing-a-transport.md", "source_location": "line 69", "weight": 1.0}, {"source": "docs_writing_a_transport_store_contract", "target": "docs_writing_a_transport_health", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/writing-a-transport.md", "source_location": "lines 55, 74", "weight": 1.0}, {"source": "docs_writing_a_transport_health", "target": "docs_writing_a_transport_real_probe", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/writing-a-transport.md", "source_location": "line 87", "weight": 1.0}, {"source": "docs_writing_a_transport_conformance_suite", "target": "docs_writing_a_transport_capabilities", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/writing-a-transport.md", "source_location": "lines 111, 121", "weight": 1.0}, {"source": "docs_writing_a_transport_conformance_suite", "target": "docs_writing_a_transport_assert_valid_key", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/writing-a-transport.md", "source_location": "line 66", "weight": 1.0}, {"source": "docs_writing_a_transport_publish_checklist", "target": "docs_writing_a_transport_conformance_suite", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/writing-a-transport.md", "source_location": "line 145", "weight": 1.0}, {"source": "docs_writing_a_transport_publish_checklist", "target": "docs_writing_a_transport_parse_config", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/writing-a-transport.md", "source_location": "line 146", "weight": 1.0}, {"source": "docs_writing_a_transport_publish_checklist", "target": "docs_writing_a_transport_credential_hy