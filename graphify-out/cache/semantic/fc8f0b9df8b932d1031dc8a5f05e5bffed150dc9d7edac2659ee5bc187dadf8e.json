{"nodes": [{"id": "readme_shared_infrastructure_model", "label": "Talking through already-shared infrastructure", "file_type": "concept", "source_file": "README.md", "source_location": "lines 3-26", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Neither machine listens on a public port, so it works from behind NAT, from a CI runner, or from a locked-down corporate network."}, {"id": "readme_workspace_secret", "label": "One 32-byte workspace secret", "file_type": "concept", "source_file": "README.md", "source_location": "lines 83, 142", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Holding the secret is membership in the workspace, so it must travel over a trusted channel; passing it as --secret ddk1_... warns because an argument is visible in shell history and the process list."}, {"id": "readme_aes_256_gcm_frames", "label": "AES-256-GCM over the whole frame including the envelope header", "file_type": "concept", "source_file": "README.md", "source_location": "line 142", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_object_key_layout", "label": "Object key layout ws/<workspace>/inbox/<peer>/<id>.ddf", "file_type": "concept", "source_file": "README.md", "source_location": "line 144", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A deliberate exception to encryption: anyone reading the transport sees workspace names, peer names and rough traffic volume, because an operator looking at a git repository should be able to tell what it holds. Message sizes and timing are visible for the same reason."}, {"id": "readme_ddrop_init", "label": "ddrop init", "file_type": "concept", "source_file": "README.md", "source_location": "lines 44-47, 151-153", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Writes a config and a secret beside it; --root points at a folder, --github at a repo, and --secret - joins an existing workspace by reading the secret from stdin so nothing has to be copied into place."}, {"id": "readme_ddrop_start", "label": "ddrop start", "file_type": "concept", "source_file": "README.md", "source_location": "lines 51-55, 154", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs in the foreground; backgrounding needs `exec`, otherwise kill reaps the wrapper shell and leaves the runtime serving."}, {"id": "readme_ddrop_expose", "label": "ddrop expose", "file_type": "concept", "source_file": "README.md", "source_location": "lines 57, 63, 88, 159-160", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exposes a directory or a local server and prints the exact command the other side runs, so you never have to look up your own peer id."}, {"id": "readme_ddrop_connect", "label": "ddrop connect", "file_type": "concept", "source_file": "README.md", "source_location": "lines 58, 91-94, 161", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prints an ordinary local URL so nothing on that side knows the traffic crossed a transport."}, {"id": "readme_ddrop_status", "label": "ddrop status", "file_type": "concept", "source_file": "README.md", "source_location": "line 155", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_ddrop_discover", "label": "ddrop discover", "file_type": "concept", "source_file": "README.md", "source_location": "line 156", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_ddrop_queues", "label": "ddrop queues", "file_type": "concept", "source_file": "README.md", "source_location": "line 157", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_ddrop_dashboard", "label": "ddrop dashboard", "file_type": "concept", "source_file": "README.md", "source_location": "line 158", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_ddrop_call", "label": "ddrop call", "file_type": "concept", "source_file": "README.md", "source_location": "line 162", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_ddrop_publish", "label": "ddrop publish", "file_type": "concept", "source_file": "README.md", "source_location": "line 163", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_ddrop_trace", "label": "ddrop trace", "file_type": "concept", "source_file": "README.md", "source_location": "line 166", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_ddrop_transport_health", "label": "ddrop transport list | health", "file_type": "concept", "source_file": "README.md", "source_location": "line 165", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_ddrop_keygen", "label": "ddrop keygen", "file_type": "concept", "source_file": "README.md", "source_location": "line 167", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Generates a new workspace secret for rotation."}, {"id": "readme_json_output_and_discovery", "label": "--json output and runtime discovery through config", "file_type": "concept", "source_file": "README.md", "source_location": "line 170", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Client commands find the runtime through the config they discover, so they run from the directory holding deaddrop.config.json or take --config or --socket."}, {"id": "readme_filesystem_transport", "label": "filesystem transport", "file_type": "concept", "source_file": "README.md", "source_location": "lines 118-119", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_git_transport", "label": "git transport", "file_type": "concept", "source_file": "README.md", "source_location": "lines 96-110", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Data moves by pushing and pulling a dedicated orphan branch so the repository's real history is untouched."}, {"id": "readme_github_transport", "label": "github transport", "file_type": "concept", "source_file": "README.md", "source_location": "lines 98-110, 120-121", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Authentication is whatever gh already has, so dead-drop never sees a token; the repository is created private by default if it does not exist."}, {"id": "readme_deaddrop_data_branch", "label": "deaddrop-data orphan branch", "file_type": "concept", "source_file": "README.md", "source_location": "line 110", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deleting that branch discards undelivered messages and nothing else."}, {"id": "readme_transport_policy_failover", "label": "Transport policy: failover mode", "file_type": "concept", "source_file": "README.md", "source_location": "lines 123-126", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A primary and a fallback list: when the LAN folder is unmounted the runtime works out it is gone and moves traffic to GitHub with no restart, so the caller sees a slow request rather than an error."}, {"id": "readme_transport_policy_parallel", "label": "Transport policy: parallel mode", "file_type": "concept", "source_file": "README.md", "source_location": "lines 128-130", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "For peers that cannot all reach the same transports: every message goes to every transport and the recipient takes whichever copy arrives first, at the cost of a write per transport per message."}, {"id": "readme_every_peer_polls_all_transports", "label": "Every peer polls all the transports it has", "file_type": "rationale", "source_file": "README.md", "source_location": "line 128", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Writes go to one transport, so a message written over a transport somebody else has not configured is a message that peer never receives; give every peer the same list."}, {"id": "readme_not_a_message_broker", "label": "Not a message broker", "file_type": "rationale", "source_file": "README.md", "source_location": "line 136", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A round trip over a git remote costs seconds, not milliseconds; if you have Kafka, use Kafka."}, {"id": "readme_node_20_requirement", "label": "Node.js 20.11 or newer", "file_type": "concept", "source_file": "README.md", "source_location": "line 30", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_apache_licence", "label": "Apache-2.0 licence", "file_type": "concept", "source_file": "README.md", "source_location": "line 196", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_guarantees", "label": "docs/guarantees.md", "file_type": "document", "source_file": "README.md", "source_location": "line 138", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_sdk", "label": "docs/sdk.md", "file_type": "document", "source_file": "README.md", "source_location": "line 175", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_operations", "label": "docs/operations.md", "file_type": "document", "source_file": "README.md", "source_location": "line 180", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "agents_invariant_no_transport_naming", "target": "readme_transport_policy_failover", "relation": "conceptually